# Example environment variables for fglInterpreter
# Copy this file to .env and customize as needed

# ============================================================================
# Backend Configuration
# ============================================================================

# Python environment
PYTHONUNBUFFERED=1
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================================
# Authentication Configuration
# ============================================================================

# Enable/disable authentication (set to true for production)
AUTH_ENABLED=false

# Authentication strategy: jwt, ldap, keycloak
AUTH_STRATEGY=jwt

# JWT Configuration
# IMPORTANT: Change JWT_SECRET_KEY in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-change-in-production-INSECURE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Auth Database Configuration
AUTH_DB_TYPE=sqlite
# AUTH_DB_PATH=~/.fglinterpreter/auth.db  # Default path (uncomment to override)
# AUTH_USE_MAIN_DB=false  # Set to true to use main application database

# LDAP Configuration (only if AUTH_STRATEGY=ldap)
# LDAP_SERVER=ldap://your-ldap-server:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=your-ldap-admin-password

# Keycloak Configuration (only if AUTH_STRATEGY=keycloak)
# KEYCLOAK_SERVER_URL=https://your-keycloak-server/auth
# KEYCLOAK_REALM=your-realm
# KEYCLOAK_CLIENT_ID=fglinterpreter
# KEYCLOAK_CLIENT_SECRET=your-client-secret

# Security Settings
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15
COOKIE_SECURE=false  # Set to true in production with HTTPS
COOKIE_SAMESITE=lax  # lax, strict, or none

# Database connection (optional)
# DB_HOST=localhost
# DB_PORT=9088
# DB_NAME=testdb
# DB_USER=informix
# DB_PASSWORD=

# ============================================================================
# Frontend Configuration
# ============================================================================

# Node environment
NODE_ENV=development

# API endpoint (for production builds)
VITE_API_URL=http://localhost:8000

# ============================================================================
# Docker Configuration
# ============================================================================

# Container timezone
TZ=UTC

# Enable/disable hot reload
# CHOKIDAR_USEPOLLING=true
